			<!-- Left Side: Logo -->
			<div class="col-4">
				<img t-att-src="'web/static/img/logo.jpg'" style="max-height: 70px;" alt="Logo"/>
			</div>
			<!-- Right Side: Company Details -->
			<div t-if="doc and doc.partner_id.lang == 'vi_VN'" class="col-8 text-left font-weight-bold" style="color: #28326E; font-size:14px; margin-left:20px;">
