<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_freight_trading_category">
            <field name="name">Freight Trading</field>
            <field name="description">Helps you handle your freight security.</field>
            <field name="sequence">9</field>
        </record>
        <record id="group_freight_trading_user" model="res.groups">
            <field name="name">User (Read Only)</field>
            <field name="comment">The user will be able to view documents created by everyone without editing permissions.</field>
            <field name="category_id" ref="module_freight_trading_category" />
            <field name="implied_ids" eval="[(4, ref('freight_mgmt.group_freight_user'))]" />
        </record>
        <record id="group_freight_trading_operation" model="res.groups">
            <field name="name">Operations</field>
            <field name="comment">The operations staff will be able to manage shipment details and routing, with limited access to financial notes.</field>
            <field name="category_id" ref="module_freight_trading_category" />
            <field name="implied_ids" eval="[(4, ref('group_freight_trading_user'))]" />
        </record>
        <record id="group_freight_trading_csdoc" model="res.groups">
            <field name="name">Documentation &amp; Billing</field>
            <field name="comment">The Documentation and CSDoc staff will be able to manage transport documents (B/L, DO) and handle invoicing/credit notes.</field>
            <field name="category_id" ref="module_freight_trading_category" />
            <field name="implied_ids" eval="[(4, ref('group_freight_trading_operation'))]" />
        </record>
        <record id="group_freight_trading_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="comment">Full administrative access including system configuration, credit release overrides, and record deletion.</field>
            <field name="category_id" ref="module_freight_trading_category" />
            <field name="implied_ids" eval="[(4, ref('group_freight_trading_csdoc'))]" />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>
    </data>
</odoo>
