<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seenpo_action_report_fumigation_certificate" model="ir.actions.report">
        <field name="name">Certificate of Fumigation Without Signature</field>
        <field name="model">seenpo.fumigation.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">seenpo_gcc_fumigation.report_fumigation_certificate</field>
        <field name="report_file">seenpo_gcc_fumigation.report_fumigation_certificate</field>
        <field name="paperformat_id" ref="seenpo_fumigation_paperformat_bol"/>
        <field name="print_report_name">
            ('Draft_' + (object.cargo_name or 'Cert of Fumigation')).replace('/', '-') if object.state in ['draft','submitted'] else ('Cert_No.' + (object.name or '')).replace('/', '-')
        </field>
    </record>

    <record id="seenpo_action_report_fumigation_certificate_with_sign" model="ir.actions.report">
        <field name="name">Certificate of Fumigation With Signature</field>
        <field name="model">seenpo.fumigation.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">seenpo_gcc_fumigation.report_fumi_cert_with_sign</field>
        <field name="report_file">seenpo_gcc_fumigation.report_fumi_cert_with_sign</field>
        <field name="paperformat_id" ref="seenpo_fumigation_paperformat_bol"/>
        <field name="print_report_name">
            ('Draft_' + (object.cargo_name or 'Cert of Fumigation')).replace('/', '-') if object.state in ['draft','submitted'] else ('Cert_No.' + (object.name or '')).replace('/', '-')
        </field>
    </record>

    <!-- QWeb template -->
    <template id="report_fumigation_certificate">
        <t t-call="web.basic_layout">
<!--        <t t-call="web.basic_layout">-->
            <t t-foreach="docs" t-as="doc">
                <t t-set="container_count" t-value="len(doc.container_line)"/>
                <!-- Set once per certificate so both the top and bottom ribbon
                     (which are siblings, not nested inside one another) can use it -->
                <t t-set="ribbon_text" t-value="('GLOBAL CARGO CONTROL CO., LTD ' + (('  \u2022   CERTIFICATE OF FUMIGATION  \u2022   ' + doc.name) if doc.name and doc.name != '#' else '') + '   \u2022   ') * 12"/>
                <t t-set="ribbon_text_footer" t-value="('LICENCE No.: 050/XHKT/BVTV-KD   \u2022   GLOBAL CARGO CONTROL CO., LTD ' + (('  \u2022   CERTIFICATE OF FUMIGATION  \u2022   ' + doc.name) if doc.name and doc.name != '#' else '') + '   \u2022   ') * 12"/>

                <t t-set="wm_repeat_text" t-value="'GCC - Cert No.: ' + (doc.name or '')"/>
<!--            <t t-call="seenpo_gcc_fumigation.report_fumigation_layout">-->
            <div class="page" style="font-size:18px; color:#000; position:relative; padding: 10px 40px; height: 345mm !important;">
                <link rel="stylesheet" href="/seenpo_gcc_fumigation/static/src/css/fumigation_certificate_report.css"/>

                <!-- WATERMARK + diagonal crosshatch background.
                     Built with SVG rather than CSS `background-image` /
                     `transform`: tested directly against wkhtmltopdf 0.12.x,
                     stacking two CSS repeating-linear-gradient layers renders
                     as a broken solid-dark block (a known old-WebKit gradient/
                     transparency bug), and plain CSS `transform: rotate()` on
                     the watermark text was not being applied at all in the
                     previous version. SVG `transform="rotate(...)"` on a
                     <text> element, and an SVG <pattern> for the crosshatch,
                     both render correctly and consistently instead. -->

                <t t-if="doc.name and doc.name != '#'">
                <!-- Repeating watermark -->
                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; pointer-events:none; top:0; left:0; width:100%; height:100%; z-index:-1;" viewBox="0 0 800 1120" preserveAspectRatio="none">
                    <text x="180" y="20" font-family="Times New Roman" font-size="20" font-weight="bold" fill="rgba(220, 235, 226, 0.6)" text-anchor="middle" transform="rotate(-30 180 20)">
                        <t t-esc="wm_repeat_text"/>
                    </text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; pointer-events:none; top:0; left:0; width:100%; height:100%; z-index:0;" viewBox="0 0 800 1120" preserveAspectRatio="none">
                    <text x="600" y="100" font-family="Times New Roman" font-size="20" font-weight="bold" fill="rgba(220, 235, 226, 0.6)" text-anchor="middle" transform="rotate(-30 600 100)">
                        <t t-esc="wm_repeat_text"/>
                    </text>
                </svg>

                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; pointer-events:none; top:0; left:0; width:100%; height:100%; z-index:0;" viewBox="0 0 800 1120" preserveAspectRatio="none">
                    <text x="100" y="300" font-family="Times New Roman" font-size="20" font-weight="bold" fill="rgba(220, 235, 226, 0.6)" text-anchor="middle" transform="rotate(-30 100 300)">
                        <t t-esc="wm_repeat_text"/>
                    </text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; pointer-events:none; top:0; left:0; width:100%; height:100%; z-index:0;" viewBox="0 0 800 1120" preserveAspectRatio="none">
                    <text x="700" y="350" font-family="Times New Roman" font-size="20" font-weight="bold" fill="rgba(220, 235, 226, 0.6)" text-anchor="middle" transform="rotate(-30 700 350)">
                        <t t-esc="wm_repeat_text"/>
                    </text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; pointer-events:none; top:0; left:0; width:100%; height:100%; z-index:0;" viewBox="0 0 800 1120" preserveAspectRatio="none">
                    <text x="150" y="550" font-family="Times New Roman" font-size="20" font-weight="bold" fill="rgba(220, 235, 226, 0.6)" text-anchor="middle" transform="rotate(-30 150 550)">
                        <t t-esc="wm_repeat_text"/>
                    </text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; pointer-events:none; top:0; left:0; width:100%; height:100%; z-index:0;" viewBox="0 0 800 1120" preserveAspectRatio="none">
                    <text x="150" y="850" font-family="Times New Roman" font-size="20" font-weight="bold" fill="rgba(220, 235, 226, 0.6)" text-anchor="middle" transform="rotate(-30 150 850)">
                        <t t-esc="wm_repeat_text"/>
                    </text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; pointer-events:none; top:0; left:0; width:100%; height:100%; z-index:0;" viewBox="0 0 800 1120" preserveAspectRatio="none">
                    <text x="700" y="700" font-family="Times New Roman" font-size="20" font-weight="bold" fill="rgba(220, 235, 226, 0.6)" text-anchor="middle" transform="rotate(-30 700 700)">
                        <t t-esc="wm_repeat_text"/>
                    </text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; pointer-events:none; top:0; left:0; width:100%; height:100%; z-index:0;" viewBox="0 0 800 1120" preserveAspectRatio="none">
                    <text x="450" y="1000" font-family="Times New Roman" font-size="20" font-weight="bold" fill="rgba(220, 235, 226, 0.6)" text-anchor="middle" transform="rotate(-30 450 1000)">
                        <t t-esc="wm_repeat_text"/>
                    </text>
                </svg>
                </t>

                <!-- Single watermark -->
                <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;" viewBox="0 0 800 1120" preserveAspectRatio="none">
<!--                    <defs>-->
<!--                        <pattern id="gcc_hatch" width="12" height="12" patternUnits="userSpaceOnUse">-->
<!--                            <path d="M0,12 L12,0" stroke="#1f5c3d" stroke-width="0.7" stroke-opacity="0.05"/>-->
<!--                            <path d="M-3,3 L3,-3" stroke="#1f5c3d" stroke-width="0.7" stroke-opacity="0.05"/>-->
<!--                            <path d="M9,15 L15,9" stroke="#1f5c3d" stroke-width="0.7" stroke-opacity="0.05"/>-->
<!--                            <path d="M0,0 L12,12" stroke="#1f5c3d" stroke-width="0.7" stroke-opacity="0.05"/>-->
<!--                            <path d="M-3,9 L3,15" stroke="#1f5c3d" stroke-width="0.7" stroke-opacity="0.05"/>-->
<!--                            <path d="M9,-3 L15,3" stroke="#1f5c3d" stroke-width="0.7" stroke-opacity="0.05"/>-->
<!--                        </pattern>-->
<!--                    </defs>-->
<!--                    <rect x="0" y="0" width="800" height="1120" fill="url(#gcc_hatch)"/>-->
                    <t t-if="doc.state in ['draft','submitted']">
                        <text x="420" y="620" font-family="Times New Roman" font-size="200" font-weight="bold" fill="rgba(220, 235, 226, 0.3)" text-anchor="middle" transform="rotate(-30 420 620)">
                            DRAFT
                        </text>
                    </t>
                    <t t-if="doc.state == 'cancelled'">
                        <text x="420" y="620" font-family="Times New Roman" font-size="150" font-weight="bold" fill="rgba(220, 235, 226, 0.3)" text-anchor="middle" transform="rotate(-30 420 620)">
                            CANCELLED
                        </text>
                    </t>
                    <t t-if="doc.state == 'approved'">
                        <text x="420" y="620" font-family="Times New Roman" font-size="250" font-weight="bold" fill="rgba(220, 235, 226, 0.3)" text-anchor="middle" transform="rotate(-30 420 620)">
                            GCC
                        </text>
                    </t>
                </svg>

                <!-- Everything below sits above the watermark -->
                <div style="position:relative; z-index:1;">

                    <!-- Repeating letterhead ribbon (top) -->
                    <div style="overflow:hidden; white-space:nowrap; font-size:10px; letter-spacing:1px; color:#1f5c3d; margin:0 -40px;">
                        <t t-esc="ribbon_text"/>
                    </div>

                    <!-- HEADER: logo | company block | QR code -->
                    <table style="width:100%; border-collapse:collapse; margin-top:40px;">
                        <tr>
                            <td style="width:15%; text-align:left;vertical-align:middle;">
                                <img class="logo-img" src="/seenpo_gcc_fumigation/static/img/gcc_logo.png" style="max-height:60px;"/>
                            </td>
                            <td style="width:75%; vertical-align:middle; padding-left: 15px; letter-spacing:0.5px;">
                                <div t-attf-style="font-size:#{header_company_font_size} !important; font-weight:bold; color:#1f5c3d;">
                                    GLOBAL CARGO CONTROL CO., LTD
                                </div>
                                <div t-attf-style="font-size:#{header_address_font_size} !important; margin-top:2px;">
                                    Add.: 72/41, Road 16, Binh Hung Hoa Ward, Ho Chi Minh City, Vietnam<br/>
                                    Tel: 0903952171 | Email: info@giamdinhtoancau.com<br/>
                                    Website: https://www.giamdinhtoancau.com
                                </div>
                            </td>
                            <t t-if="doc.state in ['approved','cancelled'] and doc.qr_token">
                                <td style="width:10%; text-align:right; vertical-align:middle;">
                                    <t t-set="qr_code_value" t-value="'https://giamdinhtoancau.com/chungthu/' + doc.qr_token"/>
                                    <img t-att-src="'/report/qr/?value=%s&amp;version=%s&amp;fill_color=%s' % (qr_code_value, 5, '%231f5c3d')" style="width:120px; height:120px;"/>
                                </td>
                            </t>
                        </tr>
                    </table>

                    <t t-if="doc.state in ['approved','cancelled'] and doc.name != '#'">
                        <div class="original-stamp-box">
                            <img src="/seenpo_gcc_fumigation/static/img/original_stamp.png" alt="ORIGINAL"/>
                        </div>
                    </t>

                    <!-- Header separator: thick green rule + thin gold rule -->
                    <div style="border-top:3px solid #1f5c3d; margin: 20px 0;"/>

                    <!-- TITLE -->
                    <h3 t-attf-style="text-align:center; padding-top:10px; text-transform:uppercase; font-weight:bold; color:#1f5c3d; font-size:#{title_font_size} !important; letter-spacing:2px;">
                        <t t-if="doc.heading">
                            <span t-esc="doc.heading" style="font-weight:bold;"/>
                        </t>
                        <t t-else="">
                            <strong>Certificate of Fumigation</strong>
                        </t>
                    </h3>

                    <!-- CERTIFICATE NUMBER -->
                    <p style="margin-top:20px;">
                        <strong>Certificate No.:
                            <t t-if="doc.state in ['approved','cancelled'] and doc.name">
                                <t t-esc="doc.name"/>
                            </t>
                            <t t-else="">
                                #
                            </t>
                        </strong>
                    </p>

                    <p style="font-style:italic;">
                        We hereby certify that the cargo with following details:
                    </p>

                    <!-- CARGO / SHIPMENT DETAILS (single continuous list, uniform bullet) -->
                    <table id="tbl-content" t-attf-style="width:100%; border-collapse:collapse; font-size:#{content_font_size} !important;">
                        <t t-if="doc.is_shipper_name_printing or doc.is_shipper_address_printing or doc.is_shipper_phone_printing">
                        <tr>
                            <td style="width:30%; color:#1f5c3d; vertical-align:top; padding:2px 0;">
                                <span style="color:red;">▪</span>
                                <t t-if="doc.transport_type == 'pallet'">
                                    Seller:
                                </t>
                                <t t-else="">
                                    Shipper:
                                </t>
                            </td>
                            <td class="content-value" style="vertical-align:top; padding:2px 0;">
                                <t t-if="doc.is_shipper_name_printing">
                                    <t t-esc="doc.shipper_id.name or ''"/><br/>
                                </t>
                                <t t-if="doc.is_shipper_address_printing">
                                    <t t-esc="doc.shipper_address or ''"/><br/>
                                </t>
                                <t t-if="doc.is_shipper_phone_printing">
                                    <t t-esc="doc.shipper_phone or ''"/>
                                </t>
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_consignee_name_printing or doc.is_consignee_address_printing or doc.is_consignee_phone_printing">
                        <tr>
                            <td style="color:#1f5c3d; vertical-align:top; padding:2px 0;">
                                <span style="color:red;">▪</span>
                                <t t-if="doc.transport_type == 'pallet'">
                                    Buyer:
                                </t>
                                <t t-else="">
                                    Consignee:
                                </t>
                            </td>
                            <td class="content-value" style="vertical-align:top; padding:2px 0;">
                                <t t-if="doc.is_consignee_name_printing">
                                    <t t-esc="doc.consignee_id.name or ''"/><br/>
                                </t>
                                <t t-if="doc.is_consignee_address_printing">
                                    <t t-esc="doc.consignee_address or ''"/><br/>
                                </t>
                                <t t-if="doc.is_consignee_phone_printing">
                                    <t t-esc="doc.consignee_phone or ''"/>
                                </t>
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_cargo_name_printing">
                        <tr>
                            <td style="color:#1f5c3d; vertical-align:top; padding:2px 0;">
                                <span style="color:red;">▪</span> Name of commodity:
                            </td>
                            <td class="content-value" style="padding:2px 0; white-space: pre-wrap;" t-esc="doc.cargo_name"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_quantity_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Total quantity:
                            </td>
                            <td class="content-value" style="padding:2px 0;" t-esc="doc.quantity"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_gross_weight_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Total weight:
                            </td>
                            <td class="content-value" style="padding:2px 0;" t-esc="doc.gross_weight"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_vessel_name_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Means of transport:
                            </td>
                            <td class="content-value" style="padding:2px 0;" t-esc="doc.vessel_name"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_bl_number_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span>
                                <t t-if="doc.transport_type == 'sea'">
                                    Bill of lading:
                                </t>
                                <t t-if="doc.transport_type == 'air'">
                                    House airway bill:
                                </t>
                            </td>
                            <td class="content-value" style="padding:2px 0;" t-esc="doc.bl_number"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_port_loading_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span>
                                <t t-if="doc.transport_type == 'sea'">
                                    Port of loading:
                                </t>
                                <t t-if="doc.transport_type == 'road'">
                                    From:
                                </t>
                                <t t-if="doc.transport_type == 'air'">
                                    Airport of departure:
                                </t>
                            </td>
                            <td class="content-value" style="padding:2px 0;" t-esc="doc.port_loading_id or ''"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_port_discharge_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span>
                                <t t-if="doc.transport_type == 'sea'">
                                    Port of discharge:
                                </t>
                                <t t-if="doc.transport_type == 'road'">
                                    To:
                                </t>
                                <t t-if="doc.transport_type == 'air'">
                                    Airport of destination:
                                </t>
                            </td>
                            <td class="content-value" style="padding:2px 0;" t-esc="doc.port_discharge_id or ''"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_delivery_place_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Place of delivery:
                            </td>
                            <td class="content-value" style="padding:2px 0;" t-esc="doc.delivery_place"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_shipment_date_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Date of shipment:
                            </td>
                            <td class="content-value" style="padding:2px 0;">
                                <t t-if="doc.shipment_date">
                                  <span class="issue-date" t-esc="doc.shipment_date.strftime('%B %d, %Y')"/>
                                </t>
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_fumigation_date_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Date of fumigation:
                            </td>
                            <td class="content-value" style="padding:2px 0;">
                                <t t-if="doc.fumigation_date">
                                  <span class="issue-date" t-esc="doc.fumigation_date.strftime('%B %d, %Y')"/>
                                </t>
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_defumigation_date_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Date of defumigation:
                            </td>
                            <td class="content-value" style="padding:2px 0;">
                                <t t-if="doc.defumigation_date">
                                  <span class="issue-date" t-esc="doc.defumigation_date.strftime('%B %d, %Y')"/>
                                </t>
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_chemical_list_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Fumigant used:
                            </td>
                            <td class="content-value" style="padding:2px 0;">
                                <span t-field="doc.chemical_list"/>
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_dosage_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span>
                                <t t-if="doc.transport_type == 'road'">
                                    Dosage/Dilution ratio:
                                </t>
                                <t t-else="">
                                    Dosage:
                                </t>
                            </td>
                            <td class="content-value" style="padding:2px 0;">
                                <t t-set="dosage" t-value="''"/>
                                <t t-if="doc.dosage">
                                    <t t-set="dosage" t-value="doc.dosage"/>
                                </t>
                                <t t-else="">
                                    <t t-set="dosage" t-value="str(doc.dosage_number)"/>
                                    <t t-if="doc.dosage_uom_id">
                                        <t t-set="dosage" t-value="dosage + ' ' + (doc.dosage_uom_id.name or '')"/>
                                    </t>
                                </t>

                                <t t-esc="dosage"/>
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_exposure_time_printing or doc.is_exposure_degree_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Time of exposure:
                            </td>
                            <td class="content-value" style="padding:2px 0;">
                                <t t-set="exposure" t-value="''"/>
                                <t t-if="doc.is_exposure_time_printing">
                                    <t t-if="doc.exposure_time">
                                        <t t-set="exposure" t-value="doc.exposure_time"/>
                                    </t>
                                    <t t-else="">
                                        <t t-set="exposure" t-value="str(doc.exposure_time_hour)"/>
                                        <t t-if="doc.exposure_time_hour_uom_id">
                                            <t t-set="exposure" t-value="exposure + ' ' + (doc.exposure_time_hour_uom_id.name or '')"/>
                                        </t>
                                    </t>
                                </t>

                                <t t-if="doc.is_exposure_degree_printing">
                                    <t t-if="doc.exposure_time_degree_text">
                                        <t t-set="exposure" t-value="exposure + ' ' + doc.exposure_time_degree_text"/>
                                    </t>
                                    <t t-else="">
                                        <t t-set="exposure" t-value="exposure + ' AT ' + str(doc.exposure_time_degree)"/>
                                        <t t-if="doc.exposure_time_degree_uom_id">
                                            <t t-set="exposure" t-value="exposure + (doc.exposure_time_degree_uom_id.name or '')"/>
                                        </t>
                                    </t>
                                </t>

                                <t t-esc="exposure"/>
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_fumigation_place_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Place of fumigation:
                            </td>
                            <td class="content-value" style="padding:2px 0;" t-esc="doc.fumigation_place"/>
                        </tr>
                        </t>

                        <t t-if="doc.is_fumigation_results_printing">
                        <tr>
                            <td style="color:#1f5c3d; padding:2px 0;">
                                <span style="color:red;">▪</span> Results of fumigation:
                            </td>
                            <td class="content-value" style="padding:2px 0;">
                                INSECTS HAVE COMPLETELY BEEN DESTROYED
                            </td>
                        </tr>
                        </t>

                        <t t-if="doc.is_container_no_printing">
                            <tr>
                                <td style="color:#1f5c3d; padding:2px 0;">
                                    <span style="color:red;">▪</span> Container No./ Seal No.:
                                </td>
                                <t t-if="container_count > 1">
                                    <td class="content-value" style="padding:2px 0;">
                                        <i>See attached list below</i>
                                    </td>
                                </t>
                                <t t-if="container_count == 1">
                                    <t t-set="container_seal_no" t-value="''"/>
                                    <t t-set="line" t-value="doc.container_line[0]"/>
                                    <t t-if="line.container_no or line.seal_no">
                                        <t t-if="line.container_no">
                                            <t t-set="container_seal_no" t-value="container_seal_no + line.container_no"/>
                                        </t>
                                        <t t-set="container_seal_no" t-value="container_seal_no + ' / '"/>
                                        <t t-if="line.seal_no">
                                            <t t-set="container_seal_no" t-value="container_seal_no + line.seal_no"/>
                                        </t>
                                    </t>

                                    <td class="content-value" style="padding:2px 0;">
                                        <span t-raw="container_seal_no"/>
                                    </td>
                                </t>
                            </tr>
                        </t>

                    </table>

                    <!-- Hình ảnh đính kèm -->
                    <!--<t t-if="doc.image_attachment">-->
                    <!--    <div style="margin-top:10px;">-->
                    <!--        <strong>Attachments:</strong><br/>-->
                    <!--        <img t-att-src="'data:image/png;base64,%s' % doc.image_attachment.decode('utf-8')" style="width:120px; border:1px solid #ccc; padding:5px;"/>-->
                    <!--    </div>-->
                    <!--</t>-->

                    <!-- FOOTER: right-aligned date + title + signature block -->
                    <div style="margin-top:36px; width:100%; overflow:hidden;">
                        <t t-if="doc.is_ispm15_printing">
                        <div t-attf-style="float:left; width:400px; color:#1f5c3d; text-align:left; font-size:#{content_font_size} !important;">
                            <div>
                                <t t-if="doc.transport_type == 'pallet'">
                                    All wooden pallets have been fumigated and stamped in accordance with ISPM15 standard.
                                </t>
                                <t t-else="">
                                    All wood packaging materials and/or commodities have been fumigated and stamped in accordance with ISPM15 standard.
                                </t>
                            </div>
                            <div style="padding-top:20px;">
                                ISPM15 STANDARD
                            </div>
                            <table id="tbl-ippc" width="240" height="100" style="padding-top:10px;">
                                <tr>
                                    <td width="45%" style="text-align:center; vertical-align:middle;">
                                        <img class="logo-img" src="/seenpo_gcc_fumigation/static/img/ippc.png" style="max-height:90px;"/>
                                    </td>
                                    <td style="text-align:left; font-size: #{content_font_size} !important; font-weight:bold; color:#416fc0; padding-left: 20px;">
                                      VN - 050 <br/> <t t-esc="doc.chemical_list"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        </t>
                        <div t-attf-style="float:right; width:400px; text-align:center; font-size:#{signature_font_size} !important;">
                            <div style="font-style:italic;">
                                <t t-if="doc.branch_id and doc.branch_id.code == 'LS'">
                                    Lang Son province, Date:
                                </t>
                                <t t-else="">
                                    Ho Chi Minh City, Date:
                                </t>
                                <span style="text-transform:uppercase;" t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/>
                            </div>
                            <div style="margin-top:4px;">
                                Manager of Fumigation Dept.
                            </div>

<!--                            <t t-if="not print_no_sign and doc.state == 'approved'">-->
<!--                                <div style="height:100px;">-->
<!--                                    <img src="/seenpo_gcc_fumigation/static/img/signature_stamp.png"-->
<!--                                         style="position:absolute; bottom:20px; right:150px; width:230px;"/>-->
<!--                                </div>-->
<!--                            </t>-->
<!--                            <t t-else="">-->
<!--                                <div style="height:100px;"/>-->
<!--                            </t>-->
                            <!-- Tạo một thẻ mỏ neo trống ở vị trí cuối trang để chèn chữ ký -->
                            <div id="signature_section_anchor" style="height:100px;"></div>
<!--                            <div style="height:100px;">-->
<!--                                <img src="/seenpo_gcc_fumigation/static/img/signature_stamp.png"-->
<!--                                     style="position:absolute; bottom:20px; right:150px; width:230px;"/>-->
<!--                            </div>-->

                            <t t-if="not (doc.branch_id and doc.branch_id.code == 'LS')">
                            <div style="width:300px; text-align:center; padding-left:100px;">
                              <hr style="border: none; border-top: 1px solid black; margin-bottom: 5px;"/>
                            </div>
                            <span style="padding-top:4px; text-align:center; font-weight:bold;">
                                <t t-esc="doc.signer"/>
                            </span>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Repeating letterhead ribbon (bottom).
                     A direct child of .page (not the content wrapper above), so
                     "bottom:0" anchors to the actual page edge rather than to
                     the bottom of the (shorter) content block. -->
                <div style="position:absolute; bottom:0; left:0; width:100%; z-index:0; overflow:hidden; white-space:nowrap; font-size:10px; letter-spacing:1px; color:#1f5c3d;">
                    <t t-esc="ribbon_text_footer"/>
                </div>
            </div>

<!--            </t>-->
                <t t-if="container_count > 1">
                    <div class="page" style="padding: 40px; font-size: 18px; page-break-before:always;">
                        <h5 style="margin-bottom:20px;">
                            Attached list <t t-esc="doc.name"/> Original <br/><br/>
                            B/L NO: <t t-esc="doc.bl_number"/>
                        </h5>

                        <table style="width:100%; border-collapse:collapse; font-size: 18px;">
                            <tr style="font-weight:bold; border-bottom:1px solid #ccc;">
                                <td width="15%">Sequence</td>
                                <td>Container / Seal No.</td>
                            </tr>

                            <t t-set="sequence" t-value="0"/>
                            <t t-foreach="doc.container_line" t-as="row">
                                <t t-set="sequence" t-value="sequence + 1"/>
                                <tr>
                                    <td><t t-esc="sequence"/></td>
                                    <td><t t-esc="row.container_no"/> / <t t-esc="row.seal_no"/></td>
                                </tr>
                            </t>
                        </table>
                    </div>
                </t>
            </t>
<!--        </t>-->
        </t>
    </template>

    <!-- 2. MẪU BÁO CÁO KẾ THỪA: CÓ CHỮ KÝ -->
    <!-- Thuộc tính primary="True" bắt buộc phải có để biến nó thành một template độc lập hoàn toàn -->
    <template id="report_fumi_cert_with_sign" inherit_id="report_fumigation_certificate" primary="True">
        <xpath expr="//div[@id='signature_section_anchor']" position="inside">
            <t t-if="doc.state in ['approved','cancelled'] and doc.name != '#'">
                <img src="/seenpo_gcc_fumigation/static/img/signature_stamp_pdf_safe.png"
                         style="position:absolute; bottom:-10px; right:150px; width:230px;"/>
            </t>
        </xpath>
    </template>

</odoo>