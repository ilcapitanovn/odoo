<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action & Menu -->
    <record id="action_seenpo_fumigation_certificate" model="ir.actions.act_window">
        <field name="name">Fumigation Certificates</field>
        <field name="res_model">seenpo.fumigation.certificate</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_fumigation_date': 1}</field>
        <field name="help" type="html">
            <p>
                Manage fumigation certificates for GCC / Global Cargo Control.
            </p>
        </field>
    </record>

    <record id="view_seenpo_fumigation_certificate_search" model="ir.ui.view">
        <field name="name">seenpo.fumigation.certificate.search</field>
        <field name="model">seenpo.fumigation.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="customer_id" />
                <separator />
                <filter string="Draft" name="draft_cert" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending" name="submitted_cert" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved_cert" domain="[('state', '=', 'approved')]"/>
                <filter string="Cancelled" name="cancelled_cert" domain="[('state', '=', 'cancelled')]"/>
                <separator />
                <filter name="filter_fumigation_date" date="fumigation_date" default_period="this_month"/>
                <separator />
                <filter string="Sea" name="transport_sea" domain="[('transport_type', '=', 'sea')]"/>
                <filter string="Road" name="transport_road" domain="[('transport_type', '=', 'road')]"/>
                <filter string="Pallet" name="transport_pallet" domain="[('transport_type', '=', 'pallet')]"/>
                <filter string="Air" name="transport_air" domain="[('transport_type', '=', 'air')]"/>
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        string="Customers"
                        name="group_customer"
                        domain="[]"
                        context="{'group_by':'customer_id'}"
                    />
                    <filter
                        string="Transport Types"
                        name="group_transport_type"
                        domain="[]"
                        context="{'group_by':'transport_type'}"
                    />
                    <separator />
                    <filter
                        string="Shippers"
                        name="group_shipper"
                        domain="[]"
                        context="{'group_by':'shipper_id'}"
                    />
                    <filter
                        string="Consignees"
                        name="group_consignee"
                        domain="[]"
                        context="{'group_by':'consignee_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View (Danh sách chứng thư) -->
    <record id="view_seenpo_fumigation_certificate_tree" model="ir.ui.view">
        <field name="name">seenpo.fumigation.certificate.tree</field>
        <field name="model">seenpo.fumigation.certificate</field>
        <field name="arch" type="xml">
            <tree string="Certificates of Fumigation">
                <field name="name" string="Certificate No."/>
                <field name="customer_id" string="Customer"/>
                <field name="chemical_list" string="Chemical"/>
                <field name="fumigation_place" string="Fumigation Place"/>
                <field name="cargo_name_short" string="Cargo"/>
                <field name="quantity" string="Quantity"/>
                <field name="fumigation_date" widget="date" string="Fumigation Date"/>
                <field name="state" string="Status" widget="badge" optional="show"
                       decoration-success="state in ['approved']"
                       decoration-warning="state in ['submitted']"
                       decoration-info="state == 'draft'" />
            </tree>
        </field>
    </record>

    <!-- Form View (Tạo chứng thư mới) -->
    <record id="view_seenpo_fumigation_certificate_form" model="ir.ui.view">
        <field name="name">seenpo.fumigation.certificate.form</field>
        <field name="model">seenpo.fumigation.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificate of Fumigation">
                <header>
                    <field name="active" invisible="1" />
                    <field name="chemical" invisible="1" />
                    <field name="port_loading" invisible="1" />
                    <field name="port_discharge" invisible="1" />
                    <field
                        name="company_id"
                        options="{'no_create': True}"
                        groups="base.group_multi_company"
                    />
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,cancelled"/>
                    <button name="action_print_preview"
                            string="Preview"
                            type="object"
                            icon="fa-eye"
                            class="btn-info"/>
                    <button name="%(seenpo_gcc_fumigation.seenpo_action_report_fumigation_certificate_with_sign)d"
                            string="PDF (Signed)"
                            type="action"
                            attrs="{'invisible': [('name', 'in', [False, '', '#'])]}"
                            help="Generate the official certificate with signature and stamp"
                            icon="fa-file-pdf-o"
                            class="btn-secondary btn-space pdf-icon"/>
                    <button name="%(seenpo_gcc_fumigation.seenpo_action_report_fumigation_certificate)d"
                            string="PDF (Unsigned)"
                            type="action"
                            help="Generate a clean version without signature or stamp"
                            icon="fa-file-pdf-o"
                            class="btn-secondary btn-space pdf-icon"/>
                    <button name="action_submit" string="Submit" type="object"
                            states="draft" class="btn-primary"
                            groups="seenpo_gcc_fumigation.group_seenpo_fumigation_user,seenpo_gcc_fumigation.group_seenpo_fumigation_manager"/>
                    <button name="action_approve" string="Approve" type="object"
                            states="submitted" class="btn-success"
                            groups="seenpo_gcc_fumigation.group_seenpo_fumigation_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            states="submitted,approved" class="btn-danger"
                            confirm="Are you sure you want to cancel this fumigation certificate? This action can't be undone."
                            groups="seenpo_gcc_fumigation.group_seenpo_fumigation_manager"/>
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <style>
                        .padding-right-20 {
                            padding-right: 20px;
                        }
                        .align-left {
                            padding-left: 5px;
                        }

                        td:has(> .min-width-150) {
                            /* Giữ độ rộng 150px như bạn đã cấu hình thành công */
                            min-width: 150px !important;
                            width: 150px !important;

                            /* Thêm đường kẻ dọc màu xám nhạt ở cạnh phải */
                            border-right: 1px solid #ddd !important;

                            /* Tạo khoảng trống nhỏ giữa text/checkbox với đường kẻ để không bị dính sát */
                            padding-right: 10px !important;
                        }

                        /* Thêm khoảng cách thụt lề cho ô dữ liệu bên phải để chữ không chạm vào đường kẻ */
                        td:has(&gt; .min-width-150) + td {
                            padding-left: 10px !important;
                        }
                    </style>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="qr_token" readonly="1"/>
                            <field name="heading"/>
                            <field name="customer_id" placeholder="Choose customer"/>
                        </group>
                        <group>
                            <field name="transport_type" widget="radio"/>
                            <field name="branch_id" placeholder="Choose branch"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- 2. Shipper & Consignee -->
                        <page string="Shipper &amp; Consignee">
                            <group>
                                <group string="Shipper" col="10" class="m-0 p-0">
                                    <!-- Cột 1: Chiếm 3 cột (Tương đương 30% chiều rộng) -->
                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_shipper_name_printing" class="mr-2"/>
                                        <label for="shipper_id" string="Shipper" class="font-weight-bold m-0"/>
                                    </div>
                                    <!-- Cột 2: Chiếm 7 cột (Tương đương 70% chiều rộng) -->
                                    <field name="shipper_id" nolabel="1" colspan="7" class="padding-right-20"
                                           attrs="{'required': [('is_shipper_name_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_shipper_address_printing" class="mr-2"/>
                                        <label for="shipper_address" string="Shipper's Address" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="shipper_address" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_shipper_address_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_shipper_phone_printing" class="mr-2"/>
                                        <label for="shipper_phone" string="Shipper's Phone" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="shipper_phone" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_shipper_phone_printing', '=', True)]}"/>
                                </group>

                                <group string="Consignee" col="10" class="m-0 p-0">
                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3">
                                        <field name="is_consignee_name_printing" class="mr-2"/>
                                        <label for="consignee_id" string="Consignee" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="consignee_id" nolabel="1" colspan="7" class="padding-right-20"
                                           attrs="{'required': [('is_consignee_name_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3">
                                        <field name="is_consignee_address_printing" class="mr-2"/>
                                        <label for="consignee_address" string="Consignee's Address" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="consignee_address" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_consignee_address_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3">
                                        <field name="is_consignee_phone_printing" class="mr-2"/>
                                        <label for="consignee_phone" string="Consignee's Phone" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="consignee_phone" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_consignee_phone_printing', '=', True)]}"/>
                                </group>
                            </group>
                        </page>

                        <!-- 3. Cargo Information -->
                        <page string="Cargo Information">
                            <group>
                                <group col="10" class="m-0 p-0">
                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_cargo_name_printing" class="mr-2"/>
                                        <label for="cargo_name" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="cargo_name" placeholder="DRAGON FRUIT..." nolabel="1" colspan="7"
                                           attrs="{'required': [('is_cargo_name_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3"
                                         attrs="{'invisible': [('transport_type', '=', 'pallet')]}">
                                        <field name="is_vessel_name_printing" class="mr-2"/>
                                        <label for="vessel_name" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="vessel_name" placeholder="OPTIMA 2517N" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_vessel_name_printing', '=', True)], 'invisible': [('transport_type', '=', 'pallet')]}"/>

<!--                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3"-->
<!--                                         attrs="{'invisible': [('transport_type', '!=', 'sea')]}">-->
<!--                                        <field name="is_container_no_printing" class="mr-2"/>-->
<!--                                        <label for="container_no" class="font-weight-bold m-0"/>-->
<!--                                    </div>-->
<!--                                    <field name="container_no" placeholder="SNBU8452813 / NP15710" nolabel="1" colspan="7"-->
<!--                                           attrs="{'required': [('is_container_no_printing', '=', True)], 'invisible': [('transport_type', '!=', 'sea')]}"/>-->

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3"
                                         attrs="{'invisible': [('transport_type', 'not in', ['sea','air'])]}">
                                        <field name="is_bl_number_printing" class="mr-2"/>
                                        <!-- Conditional Labels targeting the same field -->
                                        <label for="bl_number" string="Bill of lading" class="font-weight-bold m-0"
                                               attrs="{'invisible': [('transport_type', '!=', 'sea')]}"/>
                                        <label for="bl_number" string="House Airway Bill" class="font-weight-bold m-0"
                                               attrs="{'invisible': [('transport_type', '!=', 'air')]}"/>
                                    </div>
                                    <field name="bl_number" placeholder="SNLFHMCL011555" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_bl_number_printing', '=', True)], 'invisible': [('transport_type', 'not in', ['sea','air'])]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_delivery_place_printing" class="mr-2"/>
                                        <label for="delivery_place" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="delivery_place" placeholder="CHICAGO, IL, USA" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_delivery_place_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3"
                                         attrs="{'invisible': [('transport_type', 'in', ['road','pallet'])]}">
                                        <field name="is_shipment_date_printing" class="mr-2"/>
                                        <label for="shipment_date" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="shipment_date" widget="date" placeholder="dd/mm/yyyy" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_shipment_date_printing', '=', True)], 'invisible': [('transport_type', 'in', ['road','pallet'])]}"/>

                                    <separator colspan="10" />

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3"
                                         attrs="{'invisible': [('transport_type', '!=', 'sea')]}">
                                        <field name="is_container_no_printing" class="mr-2"/>
                                        <label for="container_line" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="container_line" nolabel="1" colspan="7"
                                        widget="section_and_note_one2many"
                                        mode="tree"
                                        attrs="{'required': [('is_container_no_printing', '=', True)], 'invisible': [('transport_type', '!=', 'sea')]}">
                                        <tree editable="bottom" class="o_container_lines">
                                            <field name="certificate_id" invisible="1"/>
                                            <field name="sequence" widget="handle"/>
                                            <field name="container_no" widget="section_and_note_text" optional="show" />
                                            <field name="seal_no" widget="section_and_note_text" optional="show" />
                                        </tree>
                                    </field>

                                </group>

                                <group col="10" class="m-0 p-0">
                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3">
                                        <field name="is_quantity_printing" class="mr-2"/>
                                        <label for="quantity" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="quantity" placeholder="694 BAGS" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_quantity_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3"
                                         attrs="{'invisible': [('transport_type', '=', 'pallet')]}">
                                        <field name="is_gross_weight_printing" class="mr-2"/>
                                        <label for="gross_weight" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="gross_weight" placeholder="7,009,400 KGS (GROSS WEIGHT)" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_gross_weight_printing', '=', True)], 'invisible': [('transport_type', '=', 'pallet')]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3"
                                         attrs="{'invisible': [('transport_type', '=', 'pallet')]}">
                                        <field name="is_port_loading_printing" class="mr-2"/>
                                        <label for="port_loading_id" string="Port of loading" class="font-weight-bold m-0"
                                               attrs="{'invisible': [('transport_type', '!=', 'sea')]}"/>
                                        <label for="port_loading_id" string="From" class="font-weight-bold m-0"
                                               attrs="{'invisible': [('transport_type', '!=', 'road')]}"/>
                                        <label for="port_loading_id" string="Airport of departure" class="font-weight-bold m-0"
                                               attrs="{'invisible': [('transport_type', '!=', 'air')]}"/>
                                    </div>
                                    <field name="port_loading_id" placeholder="HO CHI MINH" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_port_loading_printing', '=', True)], 'invisible': [('transport_type', '=', 'pallet')]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3"
                                         attrs="{'invisible': [('transport_type', '=', 'pallet')]}">
                                        <field name="is_port_discharge_printing" class="mr-2"/>
                                        <label for="port_discharge_id" string="Port of discharge" class="font-weight-bold m-0"
                                               attrs="{'invisible': [('transport_type', '!=', 'sea')]}"/>
                                        <label for="port_discharge_id" string="To" class="font-weight-bold m-0"
                                               attrs="{'invisible': [('transport_type', '!=', 'road')]}"/>
                                        <label for="port_discharge_id" string="Airport of destination" class="font-weight-bold m-0"
                                               attrs="{'invisible': [('transport_type', '!=', 'air')]}"/>
                                    </div>
                                    <field name="port_discharge_id" placeholder="NANSHA" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_port_discharge_printing', '=', True)], 'invisible': [('transport_type', '=', 'pallet')]}"/>

                                </group>
                            </group>
                        </page>

                        <!-- 4. Fumigation Parameters -->
                        <page string="Fumigation Parameters">
                            <group>
                                <group col="10" class="m-0 p-0">
                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_chemical_list_printing" class="mr-2"/>
                                        <label for="chemical_list" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="chemical_list" nolabel="1" colspan="7"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_fumigation_place_printing" class="mr-2"/>
                                        <label for="fumigation_place" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="fumigation_place" placeholder="HO CHI MINH CITY, VIETNAM" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_fumigation_place_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_fumigation_date_printing" class="mr-2"/>
                                        <label for="fumigation_date" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="fumigation_date" widget="date" placeholder="dd/mm/yyyy" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_fumigation_date_printing', '=', True)]}"/>

                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">
                                        <field name="is_defumigation_date_printing" class="mr-2"/>
                                        <label for="defumigation_date" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="defumigation_date" widget="date" placeholder="dd/mm/yyyy" nolabel="1" colspan="7"
                                           attrs="{'required': [('is_defumigation_date_printing', '=', True)]}"/>

                                </group>

                                <group col="10" class="m-0 p-0">
                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3">
                                        <field name="is_dosage_printing" class="mr-2"/>
                                        <label for="dosage_number" class="font-weight-bold m-0"/>
                                    </div>
                                    <div class="o_row" colspan="7">
                                        <field name="dosage_number" placeholder="50" nolabel="1" class="oe_inline"
                                               attrs="{'required': [('is_dosage_printing', '=', True)]}"/>
                                        <field name="dosage_uom_id" placeholder="G/M³" nolabel="1" class="oe_inline"
                                               options="{'no_open': True, 'no_create': True}"
                                               attrs="{'required': [('is_dosage_printing', '=', True)]}"/>
                                    </div>

                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3">
                                        <field name="is_exposure_time_printing" class="mr-2"/>
                                        <label for="exposure_time_hour" class="font-weight-bold m-0"/>
                                    </div>
                                    <div class="o_row" colspan="7">
                                        <field name="exposure_time_hour" placeholder="48" nolabel="1" class="oe_inline"
                                               attrs="{'required': [('is_exposure_time_printing', '=', True)]}"/>
                                        <field name="exposure_time_hour_uom_id" placeholder="Hours" nolabel="1" class="oe_inline"
                                               options="{'no_open': True, 'no_create': True}"
                                               attrs="{'required': [('is_exposure_time_printing', '=', True)]}"/>
                                    </div>

                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3">
                                        <field name="is_exposure_degree_printing" class="mr-2"/>
                                        <label for="exposure_time_degree" class="font-weight-bold m-0"/>
                                    </div>
                                    <div class="o_row" colspan="7">
                                        <field name="exposure_time_degree" placeholder="25" nolabel="1" class="oe_inline"
                                               attrs="{'required': [('is_exposure_degree_printing', '=', True)]}"/>
                                        <field name="exposure_time_degree_uom_id" placeholder="ºC" nolabel="1" class="oe_inline"
                                               options="{'no_open': True, 'no_create': True}"
                                               attrs="{'required': [('is_exposure_degree_printing', '=', True)]}"/>
                                    </div>

                                    <div class="d-flex align-items-center mb-1 min-width-150 align-left" colspan="3">
                                        <field name="is_signer_printing" class="mr-2"/>
                                        <label for="signer" class="font-weight-bold m-0"/>
                                    </div>
                                    <field name="signer" nolabel="1" colspan="7"/>
                                </group>
                            </group>
                        </page>

<!--                        <page string="Attachments">-->
<!--                            <group>-->
<!--                                <group col="10" class="m-0 p-0">-->
<!--                                    <div class="d-flex align-items-center mb-1 min-width-150" colspan="3">-->
<!--                                        <field name="is_image_attachment_printing" class="mr-2"/>-->
<!--                                        <label for="image_attachment" class="font-weight-bold m-0"/>-->
<!--                                    </div>-->
<!--                                    <field name="image_attachment" nolabel="1" colspan="7" widget="image"/>-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <field name="scan_attachment" filename="scan_filename"/>-->
<!--                                </group>-->
<!--                            </group>-->
<!--                        </page>-->

                        <!-- 5. Other -->
                        <page string="Other">
                            <group>
                                <field name="is_fumigation_results_printing"/>
                                <field name="is_ispm15_printing"/>
                                <field name="note" placeholder="Internal notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field
                        name="message_ids"
                        widget="mail_thread"
                        options="{'post_refresh': 'recipients', 'open_attachments': True}"
                    />
                </div>
            </form>
        </field>
    </record>

    <record id="action_seenpo_fumigation_customers" model="ir.actions.client">
        <field name="name">Customers</field>
        <field name="tag">seenpo_fumigation_customers_empty</field>
    </record>

    <record id="action_seenpo_fumigation_reporting" model="ir.actions.client">
        <field name="name">Reporting</field>
