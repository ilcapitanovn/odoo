<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mto_subproduct_ignore_word_view_tree" model="ir.ui.view">
        <field name="name">mto.subproduct.ignore.word.tree</field>
        <field name="model">mto.subproduct.ignore.word</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="mto_subproduct_ignore_word_action" model="ir.actions.act_window">
        <field name="name">Sub-Product Ignore Words</field>
        <field name="res_model">mto.subproduct.ignore.word</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add words to ignore</p>
            <p>Words listed here are skipped when "Suggest Sub-Products" looks for
            products with a similar name or vendor.</p>
        </field>
    </record>

    <menuitem id="menu_mto_subproduct_ignore_word"
              name="Sub-Product Ignore Words"
              parent="purchase.menu_purchase_config"
              action="mto_subproduct_ignore_word_action"
              sequence="90"
              groups="purchase.group_purchase_manager"/>
</odoo>
