<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_mto_subproduct" model="ir.ui.view">
        <field name="name">product.template.form.mto.subproduct</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <separator string="MTO Auto PO Sub-Products"/>
                <field name="id" invisible="1"/>
                <div class="mb-2">
                    <button name="action_suggest_mto_subproducts" type="object"
                            string="Suggest Sub-Products" icon="fa-magic"
                            class="btn-secondary"
                            groups="purchase.group_purchase_manager,stock.group_stock_manager"
                            attrs="{'invisible': [('id', '=', False)]}"
                            help="Suggest sub-products by name / vendor similarity or purchase history"/>
                </div>
                <field name="mto_subproduct_ids" nolabel="1"
                       context="{'active_test': False}">
                    <tree editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="sub_product_id"
                               domain="[('purchase_ok', '=', True)]"
                               options="{'no_create': True}"/>
                        <field name="vendor_id"
                               context="{'res_partner_search_mode': 'supplier'}"
                               options="{'no_create': True}"/>
                        <field name="qty"/>
                        <field name="uom_id"/>
                        <field name="standard_price_usd" class="oe_inline" widget='monetary'
                               readonly="1" digits="[12,0]"
                               options="{'currency_field': 'currency_id'}" />
                        <field name="standard_price_vnd" class="oe_inline" widget='monetary'
                               readonly="1" digits="[12,0]"
                               options="{'currency_field': 'currency_id'}" />
                        <field name="note" optional="hide"/>
                        <field name="active" widget="boolean_toggle"/>
                    </tree>
                </field>
                <div class="text-muted">
                    When this product generates an MTO PO, also add these products
                    to the PO (quantity = Default Qty x quantity of this product).
                    A line with a Vendor different from the PO vendor goes to a
                    separate draft PO for that vendor.
                </div>
            </xpath>
            <xpath expr="//group[@name='bill']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='description_purchase']/../.." position="attributes">
                <!-- Hide the parent group of purchase description -->
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
