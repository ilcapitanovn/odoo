<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mto_subproduct_suggest_wizard_form" model="ir.ui.view">
        <field name="name">mto.subproduct.suggest.wizard.form</field>
        <field name="model">mto.subproduct.suggest.wizard</field>
        <field name="arch" type="xml">
            <form string="Suggest Sub-Products">
                <group>
                    <group string="Suggest by">
                        <field name="template_id" readonly="1" force_save="1"/>
                        <field name="mode" widget="radio" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Capacity">
                        <field name="existing_count"/>
                        <field name="max_count"/>
                        <field name="free_slots"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('mode', '!=', 'similar')]}">
                    <field name="keywords" placeholder="e.g. HCM SHA JJ HNT 40RH"/>
                    <field name="vendor_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           context="{'res_partner_search_mode': 'supplier'}"/>
                    <field name="ignore_word_ids" widget="many2many_tags"
                           options="{'no_open': True}"/>
                </group>
                <div class="mb-2">
                    <button name="action_reload" type="object" string="Reload"
                            icon="fa-refresh" class="btn-secondary"/>
                    <span class="text-muted ml-2"><field name="info" nolabel="1"/></span>
                </div>
                <p class="text-muted">
                    Choose how to suggest, change keywords / ignored words if needed,
                    then click Reload. Tick the lines to add, adjust vendor / quantity
                    and click "Add Selected". Everything stays editable in the
                    product afterwards.
                </p>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="false"
                          decoration-muted="not selected">
                        <field name="sequence" widget="handle"/>
                        <field name="selected"/>
                        <field name="sub_product_id" readonly="1" force_save="1"/>
                        <field name="vendor_id"
                               context="{'res_partner_search_mode': 'supplier'}"
                               options="{'no_create': True}"/>
                        <field name="qty"/>
                        <field name="uom_id"/>
                        <field name="evidence"/>
                        <field name="note" optional="hide"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Add Selected" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
