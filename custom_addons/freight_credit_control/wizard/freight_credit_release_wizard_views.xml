<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="freight_credit_release_wizard_view_form" model="ir.ui.view">
        <field name="name">freight.credit.release.wizard.view.form</field>
        <field name="model">freight.credit.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Credit Release">
                <field name="booking_id" invisible="1"/>
                <field name="wizard_action" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="partner_due_amount" readonly="1"/>
                        <field name="partner_credit_overdue_days" readonly="1"/>
                    </group>
                </group>
                <group>
                    <field name="note" nolabel="1" placeholder="e.g. Customer promised wire transfer by 5 PM today."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Submit Request" class="btn-primary"
                            attrs="{'invisible': [('wizard_action', '!=', 'request')]}"/>
                    <button name="action_confirm" type="object" string="Confirm Rejection" class="btn-primary"
                            attrs="{'invisible': [('wizard_action', '!=', 'reject')]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
